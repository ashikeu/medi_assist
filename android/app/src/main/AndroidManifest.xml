<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ==================== PERMISSIONS ==================== -->

    <!-- The `alarm` plugin's manifest declares READ_EXTERNAL_STORAGE for
         user-supplied alarm audio. This app never reads one at ring time: a
         ringtone or audio file the user picks is copied into the app's own
         documents directory straight away (see AlarmSoundService), and the
         picker itself grants a one-off URI. So strip the permission during
         merge rather than ship a sensitive one that would need a Play
         declaration — and keep it that way: if a future change plays a sound
         from shared storage directly, it will break on a reboot re-arm long
         before anyone notices the missing permission. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        tools:node="remove"/>

    <!-- Notifications (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Exact alarms. SCHEDULE_EXACT_ALARM is user-grantable on Android 12/13;
         USE_EXACT_ALARM is auto-granted on Android 14+ for alarm-style apps and
         requires a Play Console declaration (see docs/play-store-checklist.md). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Reschedule alarms and notifications after a device restart -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Keeps the CPU awake long enough for a firing alarm to be handled -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Lets the user exempt the app from Doze so alarms are not deferred -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <!-- Rings the alarm screen over the lock screen -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>

    <!-- One-off coordinate for the prayer-time calculation. Foreground only:
         there is no background location access and no tracking — the user taps
         "Use my location", the app takes a single fix and stores the resulting
         coordinate. Coarse alone is enough to name a city and calculate to the
         minute; fine is declared so a user who grants precise location gets it,
         but the feature works without it. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>

    <application
        android:label="MediAssist"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules">

        <!-- ==================== MAIN ACTIVITY ==================== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize"
            android:showWhenLocked="true"
            android:turnScreenOn="true">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ==================== ALARM PACKAGE ==================== -->
        <!-- AlarmService and AlarmReceiver are declared by the `alarm` plugin's
             own manifest and merged in automatically. Only
             NotificationOnKillService needs declaring here. -->
        <service
            android:name="com.gdelataillade.alarm.services.NotificationOnKillService"
            android:exported="false"
            android:stopWithTask="false"/>

        <!-- The plugin's BootReceiver re-arms each stored alarm at the
             dateTime it was last saved with. That time is in the past by the
             time the device reboots, so AlarmApiImpl treats it as "fire now"
             and every reminder rings at once on startup.
             DailyAlarmRearmReceiver below handles BOOT_COMPLETED instead and
             rolls each alarm forward to its next occurrence first. -->
        <receiver
            android:name="com.gdelataillade.alarm.alarm.BootReceiver"
            tools:node="remove"/>

        <!-- ==================== DAILY ALARM RE-ARM ==================== -->
        <!-- Repeats alarm-type reminders without a Flutter engine: a
             self-perpetuating AlarmManager sweep plus boot/app-update
             recovery. See DailyAlarmRearmReceiver.kt. -->
        <receiver
            android:name=".DailyAlarmRearmReceiver"
            android:enabled="true"
            android:exported="false">
            <!-- ACTION_REARM_ALARMS needs no filter: the sweep sends it as an
                 explicit intent to this class. -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- ==================== LOCAL NOTIFICATIONS ==================== -->
        <!-- flutter_local_notifications ships no receivers in its own manifest,
             so these must stay or scheduled notifications never fire. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"
            android:exported="false"/>

        <!-- Reschedules pending notifications after reboot -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Handles notification action buttons -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false"/>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>

    <!-- Required to open the system settings screens we deep-link into -->
    <queries>
        <intent>
            <action android:name="android.settings.REQUEST_SCHEDULE_EXACT_ALARM"/>
        </intent>
        <intent>
            <action android:name="android.settings.IGNORE_BATTERY_OPTIMIZATION_SETTINGS"/>
        </intent>
    </queries>

</manifest>
