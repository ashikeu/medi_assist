<?xml version="1.0" encoding="utf-8"?>
<!--
  Health data never leaves the device. Cloud backup and device-to-device
  transfer are both disabled, which matches what the app tells users and keeps
  the Play Data Safety declaration simple.

  Consequence: the in-app Backup & Restore export is the only way a user moves
  their data to a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
